{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": true },
  "rewrites": [
    { "source": "/giris", "destination": "/giris.html" },
    { "source": "/kayit", "destination": "/kayit.html" },
    { "source": "/araclarim", "destination": "/araclarim.html" },
