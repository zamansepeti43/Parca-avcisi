# Public browser configuration. Never place a service-role key in this file.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Turnstile CAPTCHA (required for auth pages)
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Optional SEO/analytics configuration.
VITE_SITE_URL=https://parca-avcisi.vercel.app
VITE_GA_ID=
VITE_GOOGLE_SITE_VERIFICATION=

# Server-side only. Never expose this as VITE_GEMINI_API_KEY.
GEMINI_API_KEY=your-gemini-api-key

# Supabase service role (server-side only, for API routes)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
